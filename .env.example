# Copy to .env next to compose.yml. Never commit .env.
# The container runs in hosted mode by default (RELAY_MODE=hosted in the image).

# --- required in hosted mode ---------------------------------------------

# Signs operator login cookies. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Signs anonymous demo tokens. Generate with: openssl rand -hex 32
ANON_TOKEN_SECRET=

# Used once, on first start with an empty database, to create the first
# operator. Can be removed from .env afterwards.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# --- strongly recommended -------------------------------------------------

# Browser origins allowed to open sessions and request anonymous tokens.
# Comma-separated. Unset = any origin (the relay logs a warning).
ALLOWED_ORIGINS=https://app.example.com
# Origins allowed to open sessions, if different (default: ALLOWED_ORIGINS).
# "*" lets any page embed the relay with a user's token.
# SESSION_ALLOWED_ORIGINS=*

# Set both to true when the admin UI is reached through an HTTPS reverse proxy.
ADMIN_COOKIE_SECURE=false
ADMIN_TRUST_PROXY=false

# The public port sits behind a TLS-terminating proxy that appends the client
# address to X-Forwarded-For. Set to false when clients connect directly.
TRUST_PROXY=true

# --- optional -------------------------------------------------------------

# Bearer token that lets a Prometheus scraper read /metrics on the admin port.
METRICS_TOKEN=
# Serve /metrics without authentication (only when the admin port is reachable
# solely over a private network, e.g. a platform metrics scraper).
METRICS_PUBLIC=false

# Require a Cloudflare Turnstile check before issuing anonymous tokens.
TURNSTILE_SECRET=

# External OIDC provider (all three required to enable).
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=

# Disable the anonymous demo tier entirely.
ANON_ENABLED=true

# "invite": new external accounts stay pending until they redeem an invite code.
SIGNUP_MODE=open

# Tier overrides, e.g. {"user":{"quotaBytes":53687091200}}
TIERS_JSON=

# 0 = off (recommended when hosted), 1 = debug (logs every packet), 2 = trace.
LOG_LEVEL=0
