# Copy to .env next to compose.yml. Never commit .env.

# Required. Signs admin session cookies. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Used once, on first start with an empty database, to create the admin user.
# Can be removed from .env afterwards.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Set both to true when the admin UI is reached through an HTTPS reverse proxy.
ADMIN_COOKIE_SECURE=false
ADMIN_TRUST_PROXY=false

# 0 = off, 1 = debug (logs every packet), 2 = trace.
LOG_LEVEL=1
